{% extends 'base.html.twig' %}

{% block title %}Ide index{% endblock %}

{% block body %}
    <h1>Ide index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for ide in ides %}
            <tr>
                <td>{{ ide.id }}</td>
                <td>{{ ide.nom }}</td>
                <td>
                    <a href="{{ path('app_ide_show', {'id': ide.id}) }}">show</a>
                    <a href="{{ path('app_ide_edit', {'id': ide.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_ide_new') }}">Create new</a>
{% endblock %}
